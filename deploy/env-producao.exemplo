# Modelo do .env do servidor (Hostinger). Copie para ~/erp/compartilhado/.env e preencha.
# NUNCA coloque este arquivo preenchido no Git, em conversa ou em e-mail.
APP_NAME="Local Estacionamento"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://erp.localestacionamento.com.br
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# banco do ERP (hPanel › Bancos de dados)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u612820499_erp
DB_USERNAME=
DB_PASSWORD=

# banco do sistema atual (só leitura pela importação); o mesmo do database.php do sistema atual
LEGADO_DB_HOST=localhost
LEGADO_DB_DATABASE=u612820499_senna
LEGADO_DB_USERNAME=
LEGADO_DB_PASSWORD=

# paralelo (etapa 5): espelho de hora em hora; desligar (false) na virada
ERP_ESPELHO_ATIVO=true
ERP_EMPRESA_NOME="Local Estacionamento"
ERP_BACKUP_DIAS=14
ERP_INATIVIDADE_MINUTOS=10

SESSION_DRIVER=database
SESSION_LIFETIME=12
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="nao-responda@localestacionamento.com.br"
MAIL_FROM_NAME="${APP_NAME}"
